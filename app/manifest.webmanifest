{
  "name": "Baja Blast",
  "short_name": "Baja Blast",
  "description": "The kitchen calendar — events, groceries, chores and photos.",
  "id": "/mobile",
  "start_url": "/mobile",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Grocery list", "url": "/mobile#grocery", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Add an event", "url": "/mobile#calendar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Chores", "url": "/mobile#chores", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}

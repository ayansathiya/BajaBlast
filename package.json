{
  "name": "baja-blast-kiosk",
  "version": "1.0.0",
  "description": "Premium ambient calendar kiosk for Mac mini + kitchen display",
  "private": true,
  "type": "module",
  "main": "app/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node app/launch.cjs",
    "github": "bash setup/github-setup.sh",
    "test": "node test/update.test.cjs && node test/bootstrap.test.cjs && node test/collapse.test.cjs && node test/recipes.test.cjs && node test/bake.test.cjs && node packaging/test-live.cjs",
    "pi": "bash packaging/build-deb.sh",
    "mac": "npm run build && electron .",
    "mac:dev": "cross-env BAJA_DEV=1 electron .",
    "mac:app": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "framer-motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "cross-env": "^7.0.3"
  },
  "build": {
    "appId": "com.bajablast.kiosk",
    "productName": "Baja Blast",
    "files": [
      "dist/**/*",
      "app/**/*",
      "build.json",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  }
}
